{
  "name": "@portabletext/react-native",
  "version": "3.0.0",
  "description": "Render Portable Text with React Native",
  "keywords": [
    "portable-text"
  ],
  "homepage": "https://github.com/portabletext/react-native-portabletext#readme",
  "bugs": {
    "url": "https://github.com/portabletext/react-native-portabletext/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portabletext/react-native-portabletext.git"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "format": "prettier --write --cache --ignore-unknown .",
    "lint": "eslint .",
    "prepare": "pnpm build",
    "release": "changeset publish",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "prettier": "@sanity/prettier-config",
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@portabletext/toolkit": "^6.1.0",
    "@portabletext/types": "^4.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-flow": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/typescript-config": "^0.88.1",
    "@sanity/prettier-config": "^3.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2 || ^19",
    "react-native": "^0.79 || ^0.80 || ^0.81 || ^0.82.0 || ^0.83.0 || ^0.84.0 || ^0.85.0 || ^0.86.0 || ^0.87.0 || ^0.88.0"
  },
  "packageManager": "pnpm@12.23.0",
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
